      "ThirdPartyAnalysis": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Codigo unico da analise (formato: ddmmyyyyID)",
            "example": "010120241234"
          },
          "name": {
            "type": "string",
            "description": "Nome da empresa/pessoa analisada",
            "example": "Empresa Exemplo LTDA"
          },
          "cnpj": {
            "type": "string",
            "description": "CNPJ da empresa (null para analises internacionais)",
            "example": "12345678000190"
          },
          "process_status": {
            "type": "string",
            "description": "Status do processamento das consultas",
            "enum": ["open", "finished", "error", "waiting_approval", "reproved", "finished_consults"],
            "example": "finished"
          },
          "status": {
            "type": "string",
            "description": "Status da analise definido pelo usuario",
            "enum": ["open", "analyze", "approved", "rejected"],
            "example": "approved"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Data de criacao",
            "example": "2024-01-15 10:30:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Data da ultima atualizacao",
            "example": "2024-01-20 14:45:00"
          },
          "risk": {
            "type": "string",
            "nullable": true,
            "description": "Classificacao de risco atribuida",
            "enum": ["very_low", "low", "medium", "high", "very_high", null],
            "example": "low"
          },
          "automatic_risk": {
            "type": "string",
            "nullable": true,
            "description": "Risco calculado automaticamente pelo sistema"
          },
          "expiry_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Data de expiracao da analise",
            "example": "2025-12-31"
          },
          "archived": {
            "type": "string",
            "description": "Status de arquivamento",
            "enum": ["yes", "no"],
            "example": "no"
          },
          "notes": {
            "type": "array",
            "description": "Notas/observacoes da analise",
            "items": {
              "$ref": "#/components/schemas/ThirdPartyAnalysisNote"
            }
          },
          "report_pdf": {
            "type": "string",
            "nullable": true,
            "description": "URL do relatorio PDF gerado",
            "example": "https://storage.becompliance.com/reports/analysis_123.pdf"
          },
          "type": {
            "type": "string",
            "nullable": true,
            "description": "Tipo de contrato",
            "example": "Fornecedor"
          },
          "beforms_integration_tokens": {
            "type": "array",
            "nullable": true,
            "description": "Tokens de integracao com BeForms"
          },
          "solicitation_approver_comment": {
            "type": "string",
            "nullable": true,
            "description": "Comentario do aprovador da solicitacao"
          }
        }
      },
      "ThirdPartyAnalysisNote": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
